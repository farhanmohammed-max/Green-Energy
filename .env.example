# GEMINI_API_KEY: Optional default AI Studio runtime secret.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# N8N_WEBHOOK_URL: URL Production Webhook dari workflow n8n untuk AI Konsultan Green Tech.
# Simpan hanya di server-side environment atau panel Secrets Google AI Studio (jangan di frontend).
N8N_WEBHOOK_URL=

# N8N_TIMEOUT_MS: Batas waktu tunggu respons webhook n8n dalam milidetik (default: 25000).
N8N_TIMEOUT_MS=25000
